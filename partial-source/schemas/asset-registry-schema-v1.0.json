{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thanhvietithopnghia-rgb.github.io/VietLicenSure/schemas/asset-registry-v1.0.json",
  "title": "VietLicenSure Asset Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "RegistryId", "CreatedAtUtc", "UpdatedAtUtc", "Devices", "Assets", "Assignments"],
  "properties": {
    "SchemaVersion": { "const": "1.0" },
    "RegistryId": { "type": "string", "pattern": "^VLS-REG-[A-F0-9]{32}$" },
    "CreatedAtUtc": { "type": "string", "format": "date-time" },
    "UpdatedAtUtc": { "type": "string", "format": "date-time" },
    "Devices": { "type": "array", "items": { "$ref": "#/definitions/device" } },
    "Assets": { "type": "array", "items": { "$ref": "#/definitions/asset" } },
    "Assignments": { "type": "array", "items": { "$ref": "#/definitions/assignmentEvent" } },
    "LifecycleEvents": { "type": "array", "items": { "$ref": "#/definitions/lifecycleEvent" } },
    "DocumentLinks": { "type": "array", "items": { "$ref": "#/definitions/documentLink" } }
  },
  "definitions": {
    "documentLink": {"type": "object", "additionalProperties": false, "required": ["DocumentId", "AssetId", "DeviceId", "EventId", "Reference", "FileName", "Sha256", "Length", "EvidenceStatus", "RecordedBy", "RecordedAtUtc"], "properties": {"DocumentId": {"type": "string", "pattern": "^VLS-DOC-[A-F0-9]{32}$"}, "AssetId": {"type": "string", "pattern": "^VLS-AST-[A-F0-9]{32}$"}, "DeviceId": {"type": "string", "pattern": "^VLS-DEV-[A-F0-9]{32}$"}, "EventId": {"type": "string", "pattern": "^VLS-AEV-[A-F0-9]{32}$"}, "Reference": {"type": "string", "maxLength": 200, "minLength": 1}, "FileName": {"type": "string", "maxLength": 240}, "Sha256": {"type": "string", "pattern": "^(|[A-F0-9]{64})$"}, "Length": {"type": "integer", "minimum": 0, "maximum": 10485760}, "EvidenceStatus": {"enum": ["ReferencedUnverified"]}, "RecordedBy": {"type": "string", "maxLength": 120, "minLength": 1}, "RecordedAtUtc": {"type": "string", "format": "date-time"}}},
    "scanLink": {"type": "object", "additionalProperties": false, "required": ["DeviceId", "ClientId", "ReportKind", "ObservedAtUtc", "ReceivedAtUtc", "ContentSha256"], "properties": {"DeviceId": {"type": "string", "pattern": "^VLS-DEV-[A-F0-9]{32}$"}, "ClientId": {"type": "string", "format": "uuid"}, "ReportKind": {"enum": ["EnterpriseInventory"]}, "ObservedAtUtc": {"type": "string", "format": "date-time"}, "ReceivedAtUtc": {"type": "string", "format": "date-time"}, "ContentSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DeviceId", "IdentityConfidence", "IdentifierDigests", "CreatedAtUtc", "LastSeenUtc", "ObservationCount", "LastKnownComputerName", "Manufacturer", "Model"],
      "properties": {
        "DeviceId": { "type": "string", "pattern": "^VLS-DEV-[A-F0-9]{32}$" },
        "IdentityConfidence": { "enum": ["High", "Medium", "Low"] },
        "IdentifierDigests": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "pattern": "^[A-F0-9]{64}$" } },
        "CreatedAtUtc": { "type": "string", "format": "date-time" },
        "LastSeenUtc": { "type": "string", "format": "date-time" },
        "ObservationCount": { "type": "integer", "minimum": 1 },
        "LastKnownComputerName": { "type": "string", "maxLength": 120 },
        "Manufacturer": { "type": "string", "maxLength": 120 },
        "Model": { "type": "string", "maxLength": 120 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AssetId", "DeviceId", "ExternalAssetTag", "InventoryNumber", "Status", "CreatedAtUtc", "UpdatedAtUtc"],
      "properties": {
        "AssetId": { "type": "string", "pattern": "^VLS-AST-[A-F0-9]{32}$" },
        "DeviceId": { "type": "string", "pattern": "^VLS-DEV-[A-F0-9]{32}$" },
        "ExternalAssetTag": { "type": "string", "maxLength": 120 },
        "InventoryNumber": { "type": "string", "maxLength": 120 },
        "Status": { "enum": ["Active", "Repair", "Retired", "Disposed", "Lost"] },
        "CreatedAtUtc": { "type": "string", "format": "date-time" },
        "UpdatedAtUtc": { "type": "string", "format": "date-time" },
        "LastScan": { "$ref": "#/definitions/scanLink" }
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EventId", "AssetId", "DeviceId", "Sequence", "Action", "FromStatus", "ToStatus", "DocumentReference", "Reason", "RecordedBy", "WarrantyUntilUtc", "EffectiveAtUtc", "RecordedAtUtc"],
      "properties": {
        "EventId": { "type": "string", "pattern": "^VLS-AEV-[A-F0-9]{32}$" },
        "AssetId": { "type": "string", "pattern": "^VLS-AST-[A-F0-9]{32}$" },
        "DeviceId": { "type": "string", "pattern": "^VLS-DEV-[A-F0-9]{32}$" },
        "Sequence": { "type": "integer", "minimum": 1 },
        "Action": { "enum": ["WarrantySet", "RepairOpened", "RepairClosed", "Retire", "Dispose", "MarkLost", "Reactivate"] },
        "FromStatus": { "enum": ["Active", "Repair", "Retired", "Disposed", "Lost"] },
        "ToStatus": { "enum": ["Active", "Repair", "Retired", "Disposed", "Lost"] },
        "DocumentReference": { "type": "string", "minLength": 1, "maxLength": 200 },
        "Reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "RecordedBy": { "type": "string", "minLength": 1, "maxLength": 120 },
        "WarrantyUntilUtc": { "type": "string" },
        "EffectiveAtUtc": { "type": "string", "format": "date-time" },
        "RecordedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "assignmentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EventId", "AssetId", "DeviceId", "Sequence", "Action", "AssignmentId", "PreviousAssignmentId", "AssigneeType", "AssigneeReference", "DisplayName", "EffectiveAtUtc", "RecordedAtUtc", "RecordedBy", "Reason"],
      "properties": {
        "EventId": { "type": "string", "pattern": "^VLS-AEV-[A-F0-9]{32}$" },
        "AssetId": { "type": "string", "pattern": "^VLS-AST-[A-F0-9]{32}$" },
        "DeviceId": { "type": "string", "pattern": "^VLS-DEV-[A-F0-9]{32}$" },
        "Sequence": { "type": "integer", "minimum": 1 },
        "Action": { "enum": ["Assign", "Reassign", "Release"] },
        "AssignmentId": { "type": "string", "pattern": "^VLS-ASN-[A-F0-9]{32}$" },
        "PreviousAssignmentId": { "type": "string", "pattern": "^(|VLS-ASN-[A-F0-9]{32})$" },
        "AssigneeType": { "type": "string", "pattern": "^(|User|Department|Location|Custodian)$" },
        "AssigneeReference": { "type": "string", "maxLength": 200 },
        "DisplayName": { "type": "string", "maxLength": 200 },
        "EffectiveAtUtc": { "type": "string", "format": "date-time" },
        "RecordedAtUtc": { "type": "string", "format": "date-time" },
        "RecordedBy": { "type": "string", "maxLength": 120 },
        "Reason": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
