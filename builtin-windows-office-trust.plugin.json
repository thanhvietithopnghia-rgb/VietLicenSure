{
  "SchemaVersion": "1.0",
  "PluginId": "thanhviet.builtin.windows-office-trust",
  "NameKey": "plugin.builtin.windowsOfficeTrust.name",
  "Version": "1.0.1",
  "Publisher": "Thanh Viet",
  "DescriptionKey": "plugin.builtin.windowsOfficeTrust.description",
  "MinimumToolVersion": "4.3",
  "Enabled": true,
  "Rules": [
    {
      "RuleId": "windows.sppsvc.missing",
      "Type": "Service",
      "Condition": "Missing",
      "Name": "sppsvc",
      "Severity": "Critical",
      "MessageKey": "plugin.builtin.windowsOfficeTrust.sppsvcMissing.message",
      "RemediationKey": "plugin.builtin.windowsOfficeTrust.sppsvcMissing.remediation"
    },
    {
      "RuleId": "windows.sppsvc.signature-invalid",
      "Type": "File",
      "Condition": "AuthenticodeNotValid",
      "Path": "%SystemRoot%\\System32\\sppsvc.exe",
      "Severity": "Critical",
      "MessageKey": "plugin.builtin.windowsOfficeTrust.sppsvcSignature.message",
      "RemediationKey": "plugin.builtin.windowsOfficeTrust.sppsvcSignature.remediation"
    },
    {
      "RuleId": "windows.slui.signature-invalid",
      "Type": "File",
      "Condition": "AuthenticodeNotValid",
      "Path": "%SystemRoot%\\System32\\slui.exe",
      "Severity": "High",
      "MessageKey": "plugin.builtin.windowsOfficeTrust.sluiSignature.message",
      "RemediationKey": "plugin.builtin.windowsOfficeTrust.sluiSignature.remediation"
    }
  ]
}
